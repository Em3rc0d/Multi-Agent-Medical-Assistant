diff -ruN '--exclude=MANIFEST.sha256' '--exclude=.pytest_cache' '--exclude=__pycache__' '--exclude=.github' a/src/eak_kernel/approval.py b/src/eak_kernel/approval.py
--- a/src/eak_kernel/approval.py	1970-01-01 00:00:00.000000000 +0000
+++ b/src/eak_kernel/approval.py	2026-09-16 19:19:55.429241098 +0000
@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from typing import Any
+
+from .errors import EAKError
+
+
+class ApprovalError(EAKError):
+    pass
+
+
+@dataclass(frozen=True)
+class ApprovalRequest:
+    id: str
+    execution_id: str
+    node_id: str
+    profile: str
+    required_role: str | None = None
+    scope: tuple[str, ...] = ()
+
+
+@dataclass(frozen=True)
+class ApprovalDecision:
+    request_id: str
+    principal_ref: str
+    decision: str
+    authenticated_roles: tuple[str, ...] = ()
+    payload: dict[str, Any] = field(default_factory=dict)
+    decided_at: str = field(default_factory=lambda: datetime.now(timezone.utc).isoformat())
+
+
+class ApprovalVerifier:
+    def verify(self, request: ApprovalRequest, decision: ApprovalDecision) -> None:
+        if decision.request_id != request.id:
+            raise ApprovalError("approval-request-mismatch")
+        if decision.decision not in {"APPROVE", "REJECT"}:
+            raise ApprovalError("invalid-approval-decision")
+        if request.required_role and request.required_role not in decision.authenticated_roles:
+            raise ApprovalError("required-reviewer-role-not-authenticated")
