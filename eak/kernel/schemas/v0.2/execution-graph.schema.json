{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eak.dev/schema/v0.2/execution-graph.schema.json",
  "title": "EAK Workflow / ExecutionGraph Contract v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "eak/v0.2"
    },
    "kind": {
      "const": "ExecutionGraph"
    },
    "metadata": {
      "$ref": "https://eak.dev/schema/v0.2/common.schema.json#/$defs/Metadata"
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphType",
        "entrypoints",
        "nodes",
        "edges",
        "termination"
      ],
      "properties": {
        "graphType": {
          "enum": [
            "logical",
            "physical"
          ]
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "termination": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "successStates",
            "failureStates"
          ],
          "properties": {
            "successStates": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "failureStates": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "maxWallTimeMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
        },
        "kind": {
          "enum": [
            "capability",
            "policy_gate",
            "approval",
            "transform",
            "subgraph"
          ]
        },
        "capability": {
          "$ref": "https://eak.dev/schema/v0.2/common.schema.json#/$defs/Ref"
        },
        "provider": {
          "$ref": "https://eak.dev/schema/v0.2/common.schema.json#/$defs/Ref"
        },
        "policyRef": {
          "type": "string"
        },
        "approvalProfile": {
          "type": "string"
        },
        "subgraphRef": {
          "$ref": "https://eak.dev/schema/v0.2/common.schema.json#/$defs/Ref"
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "$ref": "https://eak.dev/schema/v0.2/common.schema.json#/$defs/RetryPolicy"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        },
        "idempotencyKeyTemplate": {
          "type": "string"
        },
        "compensationNode": {
          "type": "string"
        },
        "iteration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxIterations"
          ],
          "properties": {
            "maxIterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "capability"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "capability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "policy_gate"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "policyRef"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "approval"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "approvalProfile"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "subgraph"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "subgraphRef"
            ]
          }
        }
      ]
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "on"
      ],
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "on": {
          "enum": [
            "success",
            "failure",
            "always",
            "condition"
          ]
        },
        "conditionRef": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "on": {
                "const": "condition"
              }
            },
            "required": [
              "on"
            ]
          },
          "then": {
            "required": [
              "conditionRef"
            ]
          }
        }
      ]
    }
  }
}