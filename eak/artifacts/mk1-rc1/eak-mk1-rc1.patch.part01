+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from hashlib import sha256
+from typing import Any, Protocol
+
+from .errors import EAKError
+
+
+class ArtifactAccessError(EAKError):
+    pass
+
+
+@dataclass(frozen=True)
+class StoredArtifact:
+    ref: str
+    document: dict[str, Any]
+
+
+class ArtifactStore(Protocol):
+    def put(self, *, content: bytes, media_type: str, tenant: str, artifact_type: str,
+            classification: str = "internal", generated_by: str | None = None,
+            derived_from: tuple[str, ...] = (), retention_policy: str = "default",
+            access_policy: str = "tenant-only") -> StoredArtifact: ...
+    def get(self, ref: str, *, tenant: str) -> bytes: ...
+    def metadata(self, ref: str, *, tenant: str) -> dict[str, Any]: ...
+
+
+@dataclass
+class InMemoryArtifactStore:
+    """Tenant-bound content-addressed artifact store for conformance tests.
+
+    Production deployments are expected to replace the byte backend while
+    preserving Artifact contract semantics and tenant isolation.
+    """
+
+    _content: dict[str, bytes] = field(default_factory=dict)
+    _docs: dict[str, dict[str, Any]] = field(default_factory=dict)
+
+    def put(self, *, content: bytes, media_type: str, tenant: str, artifact_type: str,
+            classification: str = "internal", generated_by: str | None = None,
+            derived_from: tuple[str, ...] = (), retention_policy: str = "def