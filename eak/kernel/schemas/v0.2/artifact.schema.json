  "properties":{"apiVersion":{"const":"eak/v0.2"},"kind":{"const":"Artifact"},"metadata":{"$ref":"https://eak.dev/schema/v0.2/common.schema.json#/$defs/Metadata"},"spec":{"type":"object","additionalProperties":false,"required":["mediaType","integrity","storage","classification","ownership","provenance","retention","access"],"properties":{"mediaType":{"type":"string","minLength":1},"artifactType":{"type":"string"},"schemaRef":{"type":"string"},"integrity":{"type":"object","additionalProperties":false,"required":["algorithm","digest"],"properties":{"algorithm":{"enum":["sha256","sha512"]},"digest":{"type":"string","minLength":32}}},"storage":{"type":"object","additionalProperties":true,"required":["ref"],"properties":{"ref":{"type":"string"}}},"classification":{"$ref":"https://eak.dev/schema/v0.2/common.schema.json#/$defs/DataClassification"},"ownership":{"type":"object","additionalProperties":false,"required":["tenant"],"properties":{"tenant":{"type":"string","minLength":1}}},"provenance":{"type":"object","additionalProperties":true},"retention":{"type":"object","additionalProperties":true,"required":["policyRef"],"properties":{"policyRef":{"type":"string"}}},"access":{"type":"object","additionalProperties":true,"required":["policyRef"],"properties":{"policyRef":{"type":"string"}}},"egressAllowed":{"type":"boolean"}}}}
