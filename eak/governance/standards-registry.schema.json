{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eak.local/schemas/standards-registry.schema.json",
  "title": "EAK Standards Registry",
  "type": "object",
  "required": ["schemaVersion", "claimPolicy", "standards", "profiles", "watchlist"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "claimPolicy": {
      "type": "object",
      "required": ["rule", "externalAttestationRequiredFor"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "externalAttestationRequiredFor": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "authority", "version", "category", "status", "coverage", "source", "requiredEvidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "title": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "status": {"enum": ["published", "recommendation", "framework", "watch"]},
          "coverage": {"enum": ["target", "partial", "implemented", "verified", "external-attestation"]},
          "source": {"type": "string", "pattern": "^https://"},
          "requiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 3}
      }
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "reason": {"type": "string", "minLength": 1},
          "source": {"type": "string", "pattern": "^https://"}
        }
      }
    }
  }
}
