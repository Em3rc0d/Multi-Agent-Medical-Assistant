{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eak.dev/schema/v0.2/provider.schema.json",
  "title":"EAK Provider Contract v0.2",
  "type":"object","additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"eak/v0.2"},"kind":{"const":"Provider"},
    "metadata":{"$ref":"https://eak.dev/schema/v0.2/common.schema.json#/$defs/Metadata"},
    "spec":{"type":"object","additionalProperties":false,"required":["providerKind","implements","runtime","execution","dataHandling","trust"],"properties":{
      "providerKind":{"enum":["agent","model","tool","retriever","external_service","human","subworkflow","adapter"]},
      "implements":{"type":"array","minItems":1,"items":{"$ref":"https://eak.dev/schema/v0.2/common.schema.json#/$defs/Ref"}},
      "runtime":{"type":"object","additionalProperties":true,"required":["type"],"properties":{"type":{"type":"string"},"protocol":{"type":"string"}}},
      "execution":{"type":"object","additionalProperties":true,"required":["determinism","sideEffects"],"properties":{"determinism":{"enum":["deterministic","stochastic","conditional"]},"sideEffects":{"enum":["none","read","write","external"]}}},
      "dataHandling":{"type":"object","additionalProperties":true,"required":["egress","persistence"],"properties":{"egress":{"enum":["none","policy-controlled","required"]},"persistence":{"type":"string"}}},
      "trust":{"type":"object","additionalProperties":true,"required":["certificationProfiles"],"properties":{"certificationProfiles":{"type":"array","items":{"type":"string"},"uniqueItems":true}}},
      "health":{"type":"object","additionalProperties":true},
      "artifacts":{"type":"array","items":{"type":"object","additionalProperties":true,"required":["role","ref","digest"],"properties":{"role":{"type":"string"},"ref":{"type":"string"},"digest":{"type":"string"}}}}
    }}
  }
}